VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-signalflow-notifications.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-signalflow-notifications
VITE_FIREBASE_STORAGE_BUCKET=demo-signalflow-notifications.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Set to "true" to connect the Firestore client to the local emulator
# (started via `npm run emulators`) instead of a real Firebase project.
VITE_USE_FIRESTORE_EMULATOR=true
